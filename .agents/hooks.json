{
  "git-guardrail": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -f ./hooks/block-git-inspection.sh ]; then ./hooks/block-git-inspection.sh; elif [ -f ./.agents/hooks/block-git-inspection.sh ]; then ./.agents/hooks/block-git-inspection.sh; fi'"
          }
        ]
      }
    ]
  }
}
